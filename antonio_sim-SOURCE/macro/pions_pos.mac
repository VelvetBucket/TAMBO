/gps/verbose 1

/gps/particle pi+

#/gps/ene/type Lin
#/gps/ene/min 10 MeV
#/gps/ene/max 10 GeV
#/gps/ene/gradient 0
#/gps/ene/intercept 1

/gps/ene/type User
/gps/hist/type energy
/control/execute macro/hists/pion_pos-Ehist.mac

/gps/direction 0 0 -1
/gps/position 2.925 0 50 cm

/run/beamOn 100

/vis/enable
/vis/viewer/flush
